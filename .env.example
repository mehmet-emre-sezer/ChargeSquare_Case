# Copy to .env and fill in local values: cp .env.example .env
# .env is git-ignored — never commit real credentials.

# --- Database (single shared Postgres; each service owns its own schema) ---
POSTGRES_DB=chargesquare
POSTGRES_USER=chargesquare
POSTGRES_PASSWORD=change_me_local
DB_HOST=db
DB_PORT=5432

# --- Service ports (host side) ---
STATION_SERVICE_PORT=8081
SESSION_SERVICE_PORT=8082

# --- Inter-service call: Session Service -> Station Service ---
# Uses the compose network hostname; override for local runs.
STATION_SERVICE_URL=http://station-service:8081
