# .env'e kopyala ve yerel değerleri gir: cp .env.example .env
# .env git tarafından yok sayılır — gerçek kimlik bilgilerini asla commit'leme.

# --- Veritabanı (tek paylaşımlı Postgres; her servis kendi şemasına sahip) ---
POSTGRES_DB=chargesquare
POSTGRES_USER=chargesquare
POSTGRES_PASSWORD=change_me_local
DB_HOST=db
DB_PORT=5432

# --- Servis portları (host tarafı) ---
STATION_SERVICE_PORT=8081
SESSION_SERVICE_PORT=8082

# --- Servisler arası çağrı: Session Service -> Station Service ---
# Compose ağ hostname'ini kullanır; yerel çalıştırmalarda değiştir.
STATION_SERVICE_URL=http://station-service:8081
